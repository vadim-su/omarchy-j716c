+    func testJ716cTakesTheMacOS273Beta1FirmwareAndOtherM5BoardsKeep272() throws {
+      let policy = try NativeInspectionPolicy.sealed()
+      let metadata = try NativeInstallationMetadata(
+        data: JSONSerialization.data(withJSONObject: [
+          "os_list": [
+            [
+              "omarchy_target": "apple-silicon-full-os", "default_os_name": "Fixture",
+              "partitions": [["size": "1GiB"]],
+            ]
+          ]
+        ]))
+      func choose(_ device: String, _ hardware: NativeInspectionHardware) throws
+        -> NativeFirmwareSelection
+      {
+        try NativeFirmwareSelection.choose(
+          deviceIdentifier: device, facts: .init(deviceIdentifier: device, hardware: hardware),
+          metadata: metadata, policy: policy)
+      }
+      // A J716c on macOS 27.3 beta 2, as read from the owner's Mac.
+      let beta2 = NativeInspectionHardware(
+        chipID: 0x6050, bootVersion: "mBoot-20457.60.77.501.2", macOSVersion: "27.3",
+        recoveryVersion: "26.3.47.5.5,0")
+      let j716c = try choose("apple,j716c", beta2)
+      XCTAssertEqual(j716c.version, "27.3")
+      XCTAssertEqual(j716c.pin?.build, "26C5035r")
+      XCTAssertEqual(j716c.sourceURL.lastPathComponent, "UniversalMac_27.3_26C5035r_Restore.ipsw")
+      // Its sibling still gets the 27.2 image.
+      XCTAssertEqual(try choose("apple,j716s", beta2).version, "27.2")
+      // On 27.2 boot firmware the 27.3 image is not offered.
+      let on272 = NativeInspectionHardware(
+        chipID: 0x6050, bootVersion: "mBoot-20457.41.3", macOSVersion: "27.2",
+        recoveryVersion: "26.2.123.0.0,0")
+      XCTAssertEqual(try choose("apple,j716c", on272).version, "27.2")
+      // The common Stage 1 is admitted on 27.3 for the J716c only.
+      let template: [String: Any] = [
+        "aurora_stage1": [
+          "kind": "common-raw-v1", "qualified_machines": ["j716cap": ["27.2"], "j716sap": ["27.2"]],
+        ]
+      ]
+      XCTAssertEqual(
+        try NativeBootChain.qualifiedFirmware(template: template, board: "j716cap"), ["27.2", "27.3"])
+      XCTAssertEqual(
+        try NativeBootChain.qualifiedFirmware(template: template, board: "j716sap"), ["27.2"])
+    }
+
